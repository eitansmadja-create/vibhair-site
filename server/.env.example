GOOGLE_CALENDAR_ID=
PORT=3000

# ---- AI chat (Claude) ----
# Get a key at https://console.anthropic.com/ (Account Settings -> API Keys).
# Required for the /api/chat endpoint (the "real thinking" chatbot). Without
# it, the site still works but the chat falls back to an error message.
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of origins allowed to call this API cross-origin.
# In production the server serves index.html itself (same-origin, no CORS
# needed) so you usually don't need to touch this. Only add an origin here if
# you deploy the frontend on a separate domain from this server.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,null

# Only needed on a host with no local file access (e.g. Render). Paste the full
# contents of the service account JSON key as a single-line env var value.
# Leave empty for local development (falls back to the local key file).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Contact form -> Google Sheets ----
# By default this reuses the same service account key as Calendar (the JSON
# file at the project root, or GOOGLE_SERVICE_ACCOUNT_JSON above). Only set
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH if you want a distinct Sheets-only key —
# e.g. one dropped in server/config/ (gitignored).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Only needed if the Sheets key must differ from GOOGLE_SERVICE_ACCOUNT_JSON
# above (e.g. a Sheets-only service account) on a host with no local file
# access. Paste the full contents of that service account JSON key here.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Spreadsheet ID (from the sheet's URL) and the range/tab to append rows to.
# Columns must already exist in this exact order: Date de soumission, Nom,
# Téléphone, Email, Message. If your data isn't on the first tab, set
# SHEET_RANGE to e.g. "MyTabName!A:E".
SHEET_ID=14TrzpF7RSCjYGTX3QepIB5CcVRtPveW6_p7mRiukxPk
SHEET_RANGE=A:E
